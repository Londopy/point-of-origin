//! chapters: writes docs/chapters.md from the compiled levels: one row per chapter
//! with its law, size, seeds, hazards and how much of a deduction its origin is.
//!
//!     nx run tools/chapters.nx -- unity/PointOfOrigin/Assets/StreamingAssets/levels.json docs/chapters.md

import std.fs
import std.json
import std.args
import std.strings

fn num(v: *json.Json, key: []u8) -> f64 {
    let m = json.get(v, key) orelse return 0.0
    return json.as_num(m) orelse 0.0
}

fn str(v: *json.Json, key: []u8) -> []u8 {
    let m = json.get(v, key) orelse return ""
    return json.as_str(m) orelse ""
}

/// How many `x,y` entries a cell list holds.
fn count_cells(text: []u8) -> i64 {
    if text.len == 0 { return 0 }
    var n: i64 = 1
    for c in text { if c == ';' { n += 1 } }
    return n
}

/// The law in a few words, from the rulestring.
fn law_name(rule: []u8) -> []u8 {
    if rule == "B1234/S012345678" { return "bloom" }
    if rule == "B1/S" { return "spark" }
    if rule == "B1357/S1357" { return "parity echo" }
    if rule == "B1/S12345678" { return "coral" }
    return rule
}

fn main() -> u8 {
    var p = args.Parser.new(os.args())
    let rest = p.rest()
    let in_path = if rest.len > 0 { rest[0] } else { "unity/PointOfOrigin/Assets/StreamingAssets/levels.json" }
    let out_path = if rest.len > 1 { rest[1] } else { "docs/chapters.md" }
    let text = fs.read(in_path) catch { eprintln("chapters: cannot read {}", .{in_path}); return 1 }
    let doc = json.parse(text[..]) catch { eprintln("chapters: {} is not JSON", .{in_path}); return 1 }
    let levels = json.get(&doc, "levels") orelse { eprintln("chapters: no levels in {}", .{in_path}); return 1 }

    var out = String.from("# Chapters\n\n")
    out.append("Generated by `tools/chapters.nx` from the compiled levels; do not edit by hand.\n")
    out.append("*Places* is how many cells inside the outline's bounding box the wanderer can stand in, and\n")
    out.append("*centred* says whether an origin sits at the box's centre, where a player who has stopped\n")
    out.append("thinking plants first. Every chapter has exactly one seed placement that grows its outline.\n\n")
    out.append("| # | Chapter | Law | Generations | Seeds | Map | Hazards | Places | Centred |\n")
    out.append("| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n")
    let n = json.len(levels)
    var i: usize = 0
    while i < n {
        let lv = json.at(levels, i) orelse break
        var hazards = String.new()
        let embers = count_cells(str(lv, "embers"))
        let acid = count_cells(str(lv, "acid"))
        let spikes = count_cells(str(lv, "spikes"))
        let spouts = count_cells(str(lv, "spouts"))
        let crumble = count_cells(str(lv, "crumble"))
        if embers > 0 { hazards.append(format("{} ember{}", .{embers, if embers == 1 { "" } else { "s" }})[..]) }
        if acid > 0 { if hazards.len > 0 { hazards.append(", ") }; hazards.append(format("{} acid", .{acid})[..]) }
        if spikes > 0 { if hazards.len > 0 { hazards.append(", ") }; hazards.append(format("{} spikes", .{spikes})[..]) }
        if spouts > 0 { if hazards.len > 0 { hazards.append(", ") }; hazards.append(format("{} spout{}", .{spouts, if spouts == 1 { "" } else { "s" }})[..]) }
        if crumble > 0 { if hazards.len > 0 { hazards.append(", ") }; hazards.append(format("{} crumbling", .{crumble})[..]) }
        if hazards.len == 0 { hazards.append("none") }
        let centred = num(lv, "centred") > 0.5
        out.append(format("| {} | {} | {} | {} | {} | {}x{} | {} | {} | {} |\n", .{
            i + 1, str(lv, "name"), law_name(str(lv, "rule")), num(lv, "steps") as i64, num(lv, "seeds") as i64,
            num(lv, "w") as i64, num(lv, "h") as i64, hazards, num(lv, "candidates") as i64, if centred { "yes" } else { "no" },
        })[..])
        i += 1
    }
    fs.write(out_path, out[..]) catch { eprintln("chapters: cannot write {}", .{out_path}); return 1 }
    println("chapters: {} rows -> {}", .{n, out_path})
    return 0
}
