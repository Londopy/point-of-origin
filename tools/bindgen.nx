//! bindgen: reads the Odin exports in native/plugin/plugin.odin and writes the
//! C# P/Invoke declarations Unity calls, so the two sides cannot drift.
//!
//!     nx run tools/bindgen.nx -- native/plugin/plugin.odin unity/PointOfOrigin/Assets/Scripts/Native/PoNative.cs
//!     nx run tools/bindgen.nx -- SRC OUT --lib origin_sim --namespace PointOfOrigin.Native --class PoNative
//!
//! It expects each export as `@(export)` on one line and the signature on the
//! next, e.g. `po_step :: proc "c" (g: rawptr, n: i32) -> i32 {`.

import std.fs
import std.strings
import std.args

struct Param {
    name: String
    ctype: String
}

struct Export {
    name: String
    params: List(Param)
    ret: String
}

/// The C# spelling of an Odin type at the C boundary. Multi-pointers become
/// arrays: P/Invoke pins a blittable array and passes its address.
fn cs_type(t: []u8) -> []u8 {
    if t == "i32" { return "int" }
    if t == "u32" { return "uint" }
    if t == "i64" { return "long" }
    if t == "u64" { return "ulong" }
    if t == "i16" { return "short" }
    if t == "u16" { return "ushort" }
    if t == "i8" { return "sbyte" }
    if t == "u8" { return "byte" }
    if t == "f32" { return "float" }
    if t == "f64" { return "double" }
    if t == "bool" { return "bool" }
    if t == "rawptr" { return "IntPtr" }
    if t == "cstring" { return "string" }
    if t == "[^]u8" { return "byte[]" }
    if t == "[^]u16" { return "ushort[]" }
    if t == "[^]i32" { return "int[]" }
    if t == "[^]u32" { return "uint[]" }
    if t == "[^]f32" { return "float[]" }
    return "IntPtr"
}

/// `name :: proc "c" (a, b: i32, p: rawptr) -> f32 {` into an Export, or null.
fn parse_export(line: []u8) -> ?Export {
    let t = line.trim()
    let name_end = t.find(" :: proc") orelse return null
    let name = t[..name_end]
    let open = t.find("(") orelse return null
    let close = strings.last_index(t, ")") orelse return null
    if close <= open { return null }
    let inner = t[open + 1..close]

    var ret = String.from("void")
    if let arrow = strings.index_from(t, "->", close) {
        var tail = t[arrow + 2..].trim()
        if let brace = tail.find("{") { tail = tail[..brace].trim() }
        ret = String.from(cs_type(tail))
    }

    var params = List(Param).new()
    var pending = List(String).new()
    if !strings.is_blank(inner) {
        for piece in inner.split(",") {
            let p = piece.trim()
            match strings.split_once(p, ":") {
                null => pending.append(String.from(p)),
                cut => {
                    let ty = cs_type(cut.1.trim())
                    for n in pending { params.append(Param{ .name = n.clone(), .ctype = String.from(ty) }) }
                    pending.clear()
                    params.append(Param{ .name = String.from(cut.0.trim()), .ctype = String.from(ty) })
                },
            }
        }
    }
    return Export{ .name = String.from(name), .params = params, .ret = ret }
}

fn main() -> u8 {
    var p = args.Parser.new(os.args())
    let lib = p.option("--lib", "-l") orelse "origin_sim"
    let ns = p.option("--namespace", "-n") orelse "PointOfOrigin.Native"
    let cls = p.option("--class", "-c") orelse "PoNative"
    let rest = p.rest()
    if rest.len < 2 {
        eprintln("usage: nx run tools/bindgen.nx -- SRC.odin OUT.cs [--lib NAME] [--namespace NS] [--class NAME]", .{})
        return 2
    }
    let src_path = rest[0]
    let out_path = rest[1]
    let src = fs.read(src_path) catch { eprintln("bindgen: cannot read {}", .{src_path}); return 1 }

    var exports = List(Export).new()
    var armed = false
    for line in src[..].lines() {
        let t = line.trim()
        if t == "@(export)" { armed = true; continue }
        if !armed { continue }
        if t.len == 0 { continue }
        armed = false
        match parse_export(t) {
            null => eprintln("bindgen: could not parse export: {}", .{t}),
            e => exports.append(e),
        }
    }
    if exports.len == 0 { eprintln("bindgen: no exports found in {}", .{src_path}); return 1 }

    var out = String.new()
    out.append("// <auto-generated>\n")
    out.append(format("// Written by tools/bindgen.nx from {}. Do not edit; rerun the build.\n", .{src_path})[..])
    out.append("// </auto-generated>\n")
    out.append("#if !UNITY_WEBGL   // no native library in the browser: SimCore stands in for the Odin core there\n")
    out.append("using System;\n")
    out.append("using System.Runtime.InteropServices;\n\n")
    out.append(format("namespace {}\n{{\n", .{ns})[..])
    out.append(format("    /// <summary>P/Invoke surface of {}.dll, the Odin simulation core.</summary>\n", .{lib})[..])
    out.append(format("    public static class {}\n    {{\n", .{cls})[..])
    out.append(format("        public const string Lib = \"{}\";\n\n", .{lib})[..])
    for e in exports {
        out.append("        [DllImport(Lib, CallingConvention = CallingConvention.Cdecl)]\n")
        out.append(format("        public static extern {} {}(", .{e.ret, e.name})[..])
        for prm, i in e.params {
            if i > 0 { out.append(", ") }
            out.append(prm.ctype[..])
            out.append(" ")
            out.append(prm.name[..])
        }
        out.append(");\n\n")
    }
    out.append("    }\n}\n#endif\n")

    fs.make_dirs(fs.parent(out_path)) catch {}
    fs.write(out_path, out[..]) catch { eprintln("bindgen: cannot write {}", .{out_path}); return 1 }
    println("bindgen: {} exports -> {}", .{exports.len, out_path})
    return 0
}
