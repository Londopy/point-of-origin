//! levels: compiles the level files under levels/ into the JSON the game
//! loads. A level names its rule and step count and draws a map where `#` is
//! rock and `o` an origin. The pattern the player must reproduce is grown by
//! the Odin simulation (native/cli), the same code the game runs, so every
//! level is solvable by construction.
//!
//!     nx run tools/levels.nx -- levels unity/PointOfOrigin/Assets/StreamingAssets/levels.json --cli tools/bin/origin_cli.exe
//!
//! Level file:
//!     name First Ripple
//!     rule B1/S012345678
//!     steps 3
//!     seeds 1              // optional: how many seeds the player gets (default: the origins)
//!     hint One point. Click where it began.
//!     map
//!     .....
//!     ..o..
//!     .....
//!     end

import std.fs
import std.json
import std.process
import std.strings
import std.args

struct Level {
    name: String
    hint: String
    tip: String
    intro: String
    outro: String
    rule: String
    steps: i64
    seeds: i64
    rows: List(String)
    origins: List((i64, i64))
    pickups: List((i64, i64))
    embers: List((i64, i64, bool))     // x, y, patrols vertically
    acid: List((i64, i64))             // `~` pools: rock to the automaton, deadly and not solid to the wanderer
    spikes: List((i64, i64))           // `^` deadly to touch, air to the automaton
    spouts: List((i64, i64))           // `f` vents in the rock that throw flame upward on a timer
    crumble: List((i64, i64))          // `c` rock that falls away after you stand on it
    says: List((String, String))       // (trigger, line): what the lantern says; triggers wake, plant, grow, found, die, seed, secret
    secret: (i64, i64)                 // `?` a cell the road does not lead to
    has_secret: bool
    start: (i64, i64)
    has_start: bool
    exit: (i64, i64)
    has_exit: bool
    w: i64
    h: i64
}

fn parse_level(text: []u8, path: []u8) -> !Level {
    var lv = Level{
        .name = String.new(), .hint = String.new(), .tip = String.new(), .intro = String.new(), .outro = String.new(), .rule = String.from("B3/S23"),
        .steps = 4, .seeds = 0, .rows = List(String).new(), .origins = List((i64, i64)).new(),
        .pickups = List((i64, i64)).new(), .embers = List((i64, i64, bool)).new(),
        .acid = List((i64, i64)).new(), .spikes = List((i64, i64)).new(), .spouts = List((i64, i64)).new(), .crumble = List((i64, i64)).new(),
        .says = List((String, String)).new(), .secret = (0, 0), .has_secret = false,
        .start = (0, 0), .has_start = false, .exit = (0, 0), .has_exit = false, .w = 0, .h = 0,
    }
    var in_map = false
    for line in text.lines() {
        let s = line.trim()
        if in_map {
            if s == "end" { in_map = false; continue }
            if s.len == 0 { continue }
            lv.rows.append(String.from(s))
            continue
        }
        if s.len == 0 or s.starts_with("//") { continue }
        if s == "map" { in_map = true; continue }
        let cut = strings.split_once(s, " ") orelse (s, "")
        let key = cut.0
        let val = cut.1.trim()
        if key == "name" { lv.name = String.from(val) }
        else if key == "hint" { lv.hint = String.from(val) }
        else if key == "tip" { lv.tip = String.from(val) }
        else if key == "intro" { lv.intro = String.from(val) }
        else if key == "outro" { lv.outro = String.from(val) }
        else if key == "rule" { lv.rule = String.from(val) }
        else if key == "steps" { lv.steps = try val.parse_int(i64) }
        else if key == "seeds" { lv.seeds = try val.parse_int(i64) }
        else if key == "say" {
            // say wake|The lantern's line.
            let parts = strings.split_once(val, "|") orelse {
                eprintln("{}: a say line needs `trigger|text`: {}", .{path, val})
                return error.InvalidInput
            }
            let trigger = parts.0.trim()
            if !(trigger == "wake" or trigger == "plant" or trigger == "grow" or trigger == "found" or trigger == "die" or trigger == "seed" or trigger == "door" or trigger == "secret") {
                eprintln("{}: unknown say trigger `{}` (wake, plant, grow, found, die, seed, door, secret)", .{path, trigger})
                return error.InvalidInput
            }
            lv.says.append((String.from(trigger), String.from(parts.1.trim())))
        }
        else {
            eprintln("{}: unknown key {}", .{path, key})
            return error.InvalidInput
        }
    }
    if lv.rows.len == 0 {
        eprintln("{}: no map", .{path})
        return error.InvalidInput
    }
    lv.h = lv.rows.len as i64
    lv.w = lv.rows[0].len as i64
    for row, y in lv.rows {
        if row.len as i64 != lv.w {
            eprintln("{}: map row {} has {} cells, the first has {}", .{path, y, row.len, lv.w})
            return error.InvalidInput
        }
        for c, x in row[..] {
            if c == 'o' or c == 'O' { lv.origins.append((x as i64, y as i64)) }
            if c == 'k' or c == 'K' { lv.pickups.append((x as i64, y as i64)) }
            if c == 'e' { lv.embers.append((x as i64, y as i64, false)) }
            if c == 'E' { lv.embers.append((x as i64, y as i64, true)) }
            if c == '~' { lv.acid.append((x as i64, y as i64)) }
            if c == '^' { lv.spikes.append((x as i64, y as i64)) }
            if c == 'f' { lv.spouts.append((x as i64, y as i64)) }
            if c == 'c' { lv.crumble.append((x as i64, y as i64)) }
            if c == '?' {
                lv.secret = (x as i64, y as i64)
                lv.has_secret = true
            }
            if c == 'x' or c == 'X' {
                lv.exit = (x as i64, y as i64)
                lv.has_exit = true
            }
            if c == 's' or c == 'S' {
                lv.start = (x as i64, y as i64)
                lv.has_start = true
            }
        }
    }
    if lv.origins.len == 0 {
        eprintln("{}: no origin ('o') on the map", .{path})
        return error.InvalidInput
    }
    if lv.seeds == 0 { lv.seeds = lv.origins.len as i64 }
    return lv
}

/// The rock rows as one string: `#` rock, `.` anything else, `sep` between rows.
/// Acid, spouts and crumble are rock as far as the automaton is concerned: nothing grows there.
fn rock_text(lv: *Level, sep: []u8) -> String {
    var out = String.new()
    for row, i in lv.rows {
        if i > 0 { out.append(sep) }
        for c in row[..] { out.push_byte(if c == '#' or c == '~' or c == 'f' or c == 'c' { '#' } else { '.' }) }
    }
    return out
}

fn has_cell(cells: *List((i64, i64)), x: i64, y: i64) -> bool {
    for c in cells.* { if c.0 == x and c.1 == y { return true } }
    return false
}

/// Cells as `x,y;x,y`.
fn cells_text(cells: *List((i64, i64))) -> String {
    var out = String.new()
    for o, i in cells.* {
        if i > 0 { out.append(";") }
        out.append(format("{},{}", .{o.0, o.1})[..])
    }
    return out
}

/// The origins as `x,y;x,y`.
fn seeds_text(lv: *Level) -> String {
    return cells_text(&lv.origins)
}

/// The embers as `x,y,h;x,y,v` (h patrols its row, v its column).
fn embers_text(lv: *Level) -> String {
    var out = String.new()
    for e, i in lv.embers {
        if i > 0 { out.append(";") }
        out.append(format("{},{},{}", .{e.0, e.1, if e.2 { "v" } else { "h" }})[..])
    }
    return out
}

/// The lantern's lines as `trigger|line||trigger|line`.
fn says_text(lv: *Level) -> String {
    var out = String.new()
    for s, i in lv.says {
        if i > 0 { out.append("||") }
        out.append(s.0[..])
        out.append("|")
        out.append(s.1[..])
    }
    return out
}

/// How much of a puzzle the origin is: the number of cells inside the target's bounding box the
/// wanderer could stand in (air over something solid), and whether an origin sits at the box's centre,
/// where a player who has stopped thinking will plant first.
fn deduction(lv: *Level, target: []u8, rock: []u8) -> (i64, bool) {
    var minx: i64 = lv.w; var maxx: i64 = -1; var miny: i64 = lv.h; var maxy: i64 = -1
    for y in 0..lv.h {
        for x in 0..lv.w {
            if target[(y * lv.w + x) as usize] == '#' {
                if x < minx { minx = x }
                if x > maxx { maxx = x }
                if y < miny { miny = y }
                if y > maxy { maxy = y }
            }
        }
    }
    if maxx < 0 { return (0, false) }
    var candidates: i64 = 0
    for y in miny..(maxy + 1) {
        for x in minx..(maxx + 1) {
            let here = rock[(y * lv.w + x) as usize] == '#'
            let below = y + 1 >= lv.h or rock[((y + 1) * lv.w + x) as usize] == '#'
            if !here and below { candidates += 1 }
        }
    }
    let cx = (minx + maxx) / 2
    let cy = (miny + maxy) / 2
    var centred = false
    for o in lv.origins {
        if (o.0 == cx or (minx + maxx) % 2 == 1 and o.0 == cx + 1) and (o.1 == cy or o.1 == cy + 1 or o.1 == maxy) { centred = true }
    }
    return (candidates, centred)
}

fn num_of(v: *json.Json, key: []u8) -> f64 {
    let m = json.get(v, key) orelse return -1.0
    return json.as_num(m) orelse -1.0
}

fn str_of(v: *json.Json, key: []u8) -> []u8 {
    let m = json.get(v, key) orelse return ""
    return json.as_str(m) orelse ""
}

fn is_origin(lv: *Level, x: i64, y: i64) -> bool {
    for o in lv.origins { if o.0 == x and o.1 == y { return true } }
    return false
}

fn is_pickup(lv: *Level, x: i64, y: i64) -> bool {
    for o in lv.pickups { if o.0 == x and o.1 == y { return true } }
    return false
}

fn is_ember(lv: *Level, x: i64, y: i64) -> bool {
    for e in lv.embers { if e.0 == x and e.1 == y { return true } }
    return false
}

/// Print the grown level: `X` rock, `o` origin, `@` origin still alive, `#` alive.
fn preview(lv: *Level, target: []u8, rock: []u8) {
    println("  {}  rule {}  steps {}  seeds {}  ({}x{})", .{lv.name, lv.rule, lv.steps, lv.seeds, lv.w, lv.h})
    for y in 0..lv.h {
        var line = String.from("    ")
        for x in 0..lv.w {
            let i = (y * lv.w + x) as usize
            let alive = i < target.len and target[i] == '#'
            let is_rock = i < rock.len and rock[i] == '#'
            if has_cell(&lv.acid, x, y) { line.push_byte('~') }
            else if has_cell(&lv.spouts, x, y) { line.push_byte('f') }
            else if has_cell(&lv.crumble, x, y) { line.push_byte('c') }
            else if has_cell(&lv.spikes, x, y) { line.push_byte('^') }
            else if is_rock { line.push_byte('X') }
            else if lv.has_start and lv.start.0 == x and lv.start.1 == y { line.push_byte('S') }
            else if lv.has_exit and lv.exit.0 == x and lv.exit.1 == y { line.push_byte('x') }
            else if is_pickup(lv, x, y) { line.push_byte('k') }
            else if is_ember(lv, x, y) { line.push_byte('e') }
            else if is_origin(lv, x, y) { line.push_byte(if alive { '@' } else { 'o' }) }
            else if alive { line.push_byte('#') }
            else { line.push_byte('.') }
        }
        println("{}", .{line})
    }
}

fn main() -> u8 {
    var p = args.Parser.new(os.args())
    let cli = p.option("--cli", "-c") orelse "tools/bin/origin_cli.exe"
    let quiet = p.flag("--quiet", "-q")
    let rest = p.rest()
    let src_dir = if rest.len > 0 { rest[0] } else { "levels" }
    let out_path = if rest.len > 1 { rest[1] } else { "levels.json" }

    let names = fs.list(src_dir) catch { eprintln("levels: cannot list {}", .{src_dir}); return 1 }
    var levels = json.array()
    var count: usize = 0
    for name in names {
        if !name[..].ends_with(".origin") { continue }
        let path = fs.join(src_dir, name[..])
        let text = fs.read(path[..]) catch { eprintln("levels: cannot read {}", .{path}); return 1 }
        let lv = parse_level(text[..], path[..]) catch { return 1 }

        let w = format("{}", .{lv.w})
        let h = format("{}", .{lv.h})
        let steps = format("{}", .{lv.steps})
        let rock_rows = rock_text(&lv, ";")
        let rock_flat = rock_text(&lv, "")
        let seeds = seeds_text(&lv)
        var argv = List([]u8).new()
        argv.append(cli)
        argv.append("--w"); argv.append(w[..])
        argv.append("--h"); argv.append(h[..])
        argv.append("--rule"); argv.append(lv.rule[..])
        argv.append("--steps"); argv.append(steps[..])
        argv.append("--seeds"); argv.append(seeds[..])
        argv.append("--rock"); argv.append(rock_rows[..])
        argv.append("--solve")
        let out = process.run(argv[..]) catch { eprintln("levels: cannot start {}", .{cli}); return 1 }
        if !out.ok() {
            eprintln("{}: {} failed:\n{}", .{path, cli, out.stderr})
            return 1
        }
        let grown = json.parse(out.text()) catch { eprintln("{}: unreadable output from {}: {}", .{path, cli, out.text()}); return 1 }
        let target = str_of(&grown, "target")
        if target.len as i64 != lv.w * lv.h {
            eprintln("{}: target has {} cells, expected {}", .{path, target.len, lv.w * lv.h})
            return 1
        }
        if num_of(&grown, "alive") <= 0.0 {
            eprintln("{}: nothing is alive after {} steps; the level cannot be played", .{path, lv.steps})
            return 1
        }

        var obj = json.object()
        json.set(&mut obj, "name", json.string(lv.name[..]))
        json.set(&mut obj, "hint", json.string(lv.hint[..]))
        json.set(&mut obj, "tip", json.string(lv.tip[..]))
        json.set(&mut obj, "intro", json.string(lv.intro[..]))
        json.set(&mut obj, "outro", json.string(lv.outro[..]))
        json.set(&mut obj, "rule", json.string(lv.rule[..]))
        json.set(&mut obj, "solutions", json.number(num_of(&grown, "solutions")))
        json.set(&mut obj, "w", json.number(lv.w as f64))
        json.set(&mut obj, "h", json.number(lv.h as f64))
        json.set(&mut obj, "birth", json.number(num_of(&grown, "birth")))
        json.set(&mut obj, "survive", json.number(num_of(&grown, "survive")))
        json.set(&mut obj, "steps", json.number(lv.steps as f64))
        json.set(&mut obj, "seeds", json.number(lv.seeds as f64))
        json.set(&mut obj, "rock", json.string(rock_flat[..]))
        json.set(&mut obj, "target", json.string(target))
        json.set(&mut obj, "origins", json.string(seeds[..]))
        let start = if lv.has_start { format("{},{}", .{lv.start.0, lv.start.1}) } else { String.new() }
        json.set(&mut obj, "start", json.string(start[..]))
        let pickups = cells_text(&lv.pickups)
        json.set(&mut obj, "pickups", json.string(pickups[..]))
        let embers = embers_text(&lv)
        json.set(&mut obj, "embers", json.string(embers[..]))
        let exit = if lv.has_exit { format("{},{}", .{lv.exit.0, lv.exit.1}) } else { String.new() }
        json.set(&mut obj, "exit", json.string(exit[..]))
        let acid = cells_text(&lv.acid)
        json.set(&mut obj, "acid", json.string(acid[..]))
        let spikes = cells_text(&lv.spikes)
        json.set(&mut obj, "spikes", json.string(spikes[..]))
        let spouts = cells_text(&lv.spouts)
        json.set(&mut obj, "spouts", json.string(spouts[..]))
        let crumble = cells_text(&lv.crumble)
        json.set(&mut obj, "crumble", json.string(crumble[..]))
        let says = says_text(&lv)
        json.set(&mut obj, "says", json.string(says[..]))
        let secret = if lv.has_secret { format("{},{}", .{lv.secret.0, lv.secret.1}) } else { String.new() }
        json.set(&mut obj, "secret", json.string(secret[..]))
        let ded = deduction(&lv, target, rock_flat[..])
        json.set(&mut obj, "candidates", json.number(ded.0 as f64))
        json.set(&mut obj, "centred", json.number(if ded.1 { 1.0 } else { 0.0 }))
        json.push(&mut levels, obj)
        count += 1
        let solutions = num_of(&grown, "solutions")
        if solutions == 0.0 {
            eprintln("{}: the solver found no seed set that grows the target, which cannot happen; check the CLI", .{path})
            return 1
        }
        if !quiet {
            preview(&lv, target, rock_flat[..])
            if solutions < 0.0 { println("    solutions: not counted (too many placements)", .{}) }
            else { println("    solutions: {}", .{solutions as i64}) }
        } else if solutions > 1.0 {
            println("levels: {} has {} seed placements that work", .{lv.name, solutions as i64})
        }
        println("levels: {}: {} places to stand inside the outline, origin {}", .{lv.name, ded.0, if ded.1 { "AT THE CENTRE (no deduction needed)" } else { "off centre" }})
    }
    if count == 0 {
        eprintln("levels: no .origin files in {}", .{src_dir})
        return 1
    }

    var doc = json.object()
    json.set(&mut doc, "levels", levels)
    fs.make_dirs(fs.parent(out_path)) catch {}
    fs.write(out_path, json.pretty(&doc, 2)[..]) catch { eprintln("levels: cannot write {}", .{out_path}); return 1 }
    println("levels: {} compiled -> {}", .{count, out_path})
    return 0
}
